Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Scanners try the same addresses on every website (/.env, /.git/config, backup copies…): refuse them before any PHP runs.
# Hidden files and folders (except /.well-known/, used for certificates), leftovers of an interrupted update
# (<file>.upd-<token>, <file>.tmp-<token>) and backup / archive / log copies of files
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(upd|upd-old|tmp)-[0-9a-f]+$ - [F,L]
RewriteRule (\.(bak|backup|old|orig|save|swp|swo|sql|sqlite|db|log|ini|zip|tar|gz|tgz|7z|rar)|~)$ - [F,NC,L]

# Force HTTPS (also when behind a proxy / CDN, which may reach the server over plain HTTP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pages
RewriteRule ^models/([a-z0-9-]+)$ /models/$1/ [R=301,L]
RewriteRule ^models/([a-z0-9-]+)/$ model.php?slug=$1 [L,QSA]
RewriteRule ^patreon-required/?$ patreon-required.php [L,QSA]
RewriteRule ^banned/?$ banned.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L,QSA]
RewriteRule ^contacts/?$ contacts.php [L,QSA]
RewriteRule ^account/?$ account.php [L,QSA]
RewriteRule ^mustardui/?$ mustardui.php [L,QSA]
RewriteRule ^docs/?$ docs.php [L,QSA]
RewriteRule ^docs/([a-z0-9-]+)$ /docs/$1/ [R=301,L]
RewriteRule ^docs/([a-z0-9-]+)/$ docs.php?slug=$1 [L,QSA]
RewriteRule ^faq/?$ faq.php [L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]
RewriteRule ^whats-new/?$ whats-new.php [L,QSA]
RewriteRule ^welcome/?$ welcome.php [L,QSA]
RewriteRule ^unlocks/?$ unlocks.php [L,QSA]
RewriteRule ^bugs/?$ bugs.php [L,QSA]
RewriteRule ^bugs/report/?$ bugs.php?report=1 [L,QSA]
RewriteRule ^bugs/([0-9]+)$ /bugs/$1/ [R=301,L]
RewriteRule ^bugs/([0-9]+)/$ bugs.php?n=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^setup/?$ setup.php [L,QSA]
RewriteRule ^accessories/?$ outfits.php [L,QSA]
RewriteRule ^accessories/([a-z0-9-]+)$ /accessories/$1/ [R=301,L]
RewriteRule ^accessories/([a-z0-9-]+)/$ outfit.php?slug=$1 [L,QSA]
RewriteRule ^gallery/?$ gallery.php [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)$ /blog/$1/ [R=301,L]
RewriteRule ^blog/([a-z0-9-]+)/$ blog.php?slug=$1 [L,QSA]
RewriteRule ^og/([A-Za-z0-9_-]+)\.jpg$ og-image.php?c=$1 [L]

# Downloads (patron links are checked against Patreon first)
RewriteRule ^share/([A-Za-z0-9]{12})/?$ share.php?code=$1 [L,QSA]
RewriteRule ^get/still/([a-f0-9]{8})/?$ auth/get-still.php?id=$1 [L,QSA]
RewriteRule ^get/still/([mo])/([a-z0-9-]+)/([a-f0-9]{8})/?$ auth/get-still.php?kind=$1&slug=$2&code=$3 [L,QSA]
RewriteRule ^get/outfit/([a-z0-9-]+)/([0-9]+)/?$ auth/get.php?type=outfit&model=$1&n=$2 [L,QSA]
RewriteRule ^get/([a-z0-9-]+)/([0-9]+)/?$ auth/get.php?model=$1&n=$2 [L,QSA]

# Unknown pages → friendly 404
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  # Assets carry ?v=<version> in their URL, so they can be cached for a long time
  <FilesMatch "\.(css|js|woff2|webp|avif|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
